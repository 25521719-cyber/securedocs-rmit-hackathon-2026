# Safe default for a production build. Set true only for an isolated public-data demo.
SECUREDOCS_ENABLE_DEMO=false

# Optional local demo JSON directory. A persistent volume is needed across container restarts.
SECUREDOCS_DEMO_DATA_DIR=.data

# TideCloak variables are intentionally omitted until the client, redirect URI,
# SDK flow, and encryption design are verified against the live service.
